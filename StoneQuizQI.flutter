// ============================================================================
// ESTATÍSTICAS E CONQUISTAS (estado global em memória)
//
// Observação: para manter o exemplo simples e 100% compatível com o DartPad,
// os dados vivem em memória (zerados a cada execução). Para persistência
// entre sessões em um app real, use o pacote `shared_preferences`.
// ============================================================================

class GameStats {
  GameStats._();
  static final GameStats instance = GameStats._();

  double maxQI = 0;
  int totalQuestions = 0;
  int totalCorrect = 0;
  int totalWrong = 0;
  int bestStreakEver = 0;
  int gamesPlayed = 0;
  double totalResponseTime = 0;
  int responseCount = 0;

  final Map<String, int> categoryCorrect = {for (final c in kCategories) c: 0};
  final Map<Difficulty, int> correctByDifficulty = {for (final d in Difficulty.values) d: 0};
  final Map<Difficulty, int> wrongByDifficulty = {for (final d in Difficulty.values) d: 0};

  final Set<String> unlockedAchievements = {};

  double get avgResponseTime => responseCount == 0 ? 0 : totalResponseTime / responseCount;

  double get accuracy => totalQuestions == 0 ? 0 : (totalCorrect / totalQuestions) * 100;

  String? get strongestCategory {
    String? best;
    int bestCount = 0;
    categoryCorrect.forEach((cat, count) {
      if (count > bestCount) {
        bestCount = count;
        best = cat;
      }
    });
    return best;
  }

  String? get weakestCategory {
    final withAnswers = categoryCorrect.entries.where((e) => e.value > 0).toList();
    if (withAnswers.isEmpty) return null;
    withAnswers.sort((a, b) => a.value.compareTo(b.value));
    return withAnswers.first.key;
  }

  /// Chamado logo após cada resposta (certa, errada ou tempo esgotado).
  /// Retorna a lista de ids de conquistas desbloqueadas agora.
  List<String> registerAnswer({
    required bool correct,
    required Difficulty difficulty,
    required String category,
    required double responseTimeSeconds,
    required int currentStreak,
    required double currentQI,
  }) {
    totalQuestions++;
    totalResponseTime += responseTimeSeconds;
    responseCount++;

    if (correct) {
      totalCorrect++;
      correctByDifficulty[difficulty] = (correctByDifficulty[difficulty] ?? 0) + 1;
      categoryCorrect[category] = (categoryCorrect[category] ?? 0) + 1;
      if (currentStreak > bestStreakEver) bestStreakEver = currentStreak;
    } else {
      totalWrong++;
      wrongByDifficulty[difficulty] = (wrongByDifficulty[difficulty] ?? 0) + 1;
    }

    if (currentQI > maxQI) maxQI = currentQI;

    final List<String> newly = [];
    void tryUnlock(String id) {
      if (!unlockedAchievements.contains(id)) {
        unlockedAchievements.add(id);
        newly.add(id);
      }
    }

    if (totalQuestions == 1) tryUnlock('primeiro_passo');
    if (correct && responseTimeSeconds < 5) tryUnlock('contra_relogio');
    if (currentStreak >= 10) tryUnlock('sequencia_ouro');
    if (currentStreak >= 20) tryUnlock('imparavel');
    if (currentQI >= 150) tryUnlock('mente_desperta');
    if (currentQI >= 200) tryUnlock('genio_formacao');
    if (currentQI >= 250) tryUnlock('nivel_einstein');
    if (totalQuestions >= 100) tryUnlock('maratonista');
    if ((categoryCorrect['Lógica de Programação'] ?? 0) >= 20) tryUnlock('mestre_logica');
    if ((categoryCorrect['Banco de Dados'] ?? 0) >= 20) tryUnlock('mestre_dados');
    if (kCategories.every((c) => (categoryCorrect[c] ?? 0) > 0)) tryUnlock('full_stack');

    _maybeUnlockLegend(newly);
    return newly;
  }

  /// Chamado ao final de cada partida.
  List<String> finishMatch({
    required Difficulty difficulty,
    required int wrongInMatch,
    required double finalQI,
  }) {
    gamesPlayed++;

    final List<String> newly = [];
    void tryUnlock(String id) {
      if (!unlockedAchievements.contains(id)) {
        unlockedAchievements.add(id);
        newly.add(id);
      }
    }

    if (wrongInMatch == 0) tryUnlock('sem_erros');
    if (difficulty == Difficulty.dificil) tryUnlock('sobrevivente');
    if (wrongInMatch >= 5 && finalQI > 0) tryUnlock('resiliente');

    _maybeUnlockLegend(newly);
    return newly;
  }

  void _maybeUnlockLegend(List<String> newly) {
    if (unlockedAchievements.contains('lenda_do_quiz')) return;
    final others = kAchievements.where((a) => a.id != 'lenda_do_quiz');
    final allUnlocked = others.every((a) => unlockedAchievements.contains(a.id));
    if (allUnlocked) {
      unlockedAchievements.add('lenda_do_quiz');
      newly.add('lenda_do_quiz');
    }
  }
}

/// Formata o QI no padrão brasileiro (vírgula), sem casas decimais quando
/// o valor é inteiro — ex.: 100 -> "100", 96.5 -> "96,5".
String formatQI(double value) {
  if (value % 1 == 0) return value.toStringAsFixed(0);
  return value.toStringAsFixed(1).replaceAll('.', ',');
}

