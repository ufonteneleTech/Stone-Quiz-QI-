class StoneQuizApp extends StatelessWidget {
  const StoneQuizApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Stone Quiz QI',
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        useMaterial3: true,
        scaffoldBackgroundColor: kBgLight,
        colorScheme: ColorScheme.fromSeed(
          seedColor: kStoneDark,
          primary: kStoneDark,
          secondary: kGold,
        ),
        appBarTheme: const AppBarTheme(
          backgroundColor: kStoneDark,
          foregroundColor: Colors.white,
          elevation: 0,
        ),
        fontFamily: 'Roboto',
      ),
      home: const HomeScreen(),
    );
  }
}

