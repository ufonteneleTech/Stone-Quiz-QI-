class DifficultyScreen extends StatelessWidget {
  const DifficultyScreen({super.key});

  @override
  Widget build(BuildContext context) {
    final unlockedImpossivel = GameStats.instance.maxQI >= kImpossivelUnlockQI;

    return Scaffold(
      appBar: AppBar(title: const Text('Escolha a Dificuldade')),
      body: ListView(
        padding: const EdgeInsets.all(20),
        children: [
          for (final d in Difficulty.values)
            _DifficultyCard(
              difficulty: d,
              locked: d == Difficulty.impossivel && !unlockedImpossivel,
            ),
        ],
      ),
    );
  }
}

class _DifficultyCard extends StatelessWidget {
  final Difficulty difficulty;
  final bool locked;

  const _DifficultyCard({required this.difficulty, required this.locked});

  @override
  Widget build(BuildContext context) {
    final color = kDifficultyColor[difficulty]!;
    final points = kDifficultyPoints[difficulty]!;
    final time = kDifficultyTime[difficulty]!;

    return Opacity(
      opacity: locked ? 0.5 : 1,
      child: Container(
        margin: const EdgeInsets.only(bottom: 14),
        decoration: BoxDecoration(
          borderRadius: BorderRadius.circular(16),
          boxShadow: [
            BoxShadow(color: color.withOpacity(0.18), blurRadius: 14, offset: const Offset(0, 6)),
          ],
        ),
        child: Material(
          color: Colors.white,
          borderRadius: BorderRadius.circular(16),
          clipBehavior: Clip.antiAlias,
          child: InkWell(
            onTap: locked
                ? () {
                    ScaffoldMessenger.of(context).showSnackBar(
                      SnackBar(content: Text('O Modo Impossível se desbloqueia com QI ${formatQI(kImpossivelUnlockQI)}+ em uma partida.')),
                    );
                  }
                : () {
                    Navigator.push(
                      context,
                      MaterialPageRoute(builder: (_) => QuizScreen(difficulty: difficulty)),
                    );
                  },
            child: IntrinsicHeight(
              child: Row(
                children: [
                  Container(width: 6, color: color),
                  Expanded(
                    child: Padding(
                      padding: const EdgeInsets.all(16),
                      child: Row(
                        children: [
                          CircleAvatar(
                            radius: 26,
                            backgroundColor: color,
                            child: locked
                                ? const Icon(Icons.lock, color: Colors.white)
                                : Text(
                                    kDifficultyLabel[difficulty]![0],
                                    style: const TextStyle(color: Colors.white, fontWeight: FontWeight.bold, fontSize: 20),
                                  ),
                          ),
                          const SizedBox(width: 16),
                          Expanded(
                            child: Column(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              children: [
                                Text(
                                  kDifficultyLabel[difficulty]!,
                                  style: const TextStyle(fontSize: 17, fontWeight: FontWeight.bold, color: kTextDark),
                                ),
                                const SizedBox(height: 4),
                                Text(
                                  kDifficultyDescription[difficulty]!,
                                  style: const TextStyle(fontSize: 12.5, color: kTextMuted),
                                ),
                                const SizedBox(height: 6),
                                Text(
                                  '+$points por acerto  •  -${(points * 0.1).toStringAsFixed(points % 10 == 0 ? 0 : 1).replaceAll('.', ',')} por erro  •  ${time}s',
                                  style: const TextStyle(fontSize: 11.5, color: kTextMuted, fontStyle: FontStyle.italic),
                                ),
                              ],
                            ),
                          ),
                          const Icon(Icons.chevron_right, color: kTextMuted),
                        ],
                      ),
                    ),
                  ),
                ],
              ),
            ),
          ),
        ),
      ),
    );
  }
}

// ============================================================================
// TELA DO QUIZ
// ============================================================================

class QuizScreen extends StatefulWidget {
  final Difficulty difficulty;

  const QuizScreen({super.key, required this.difficulty});

  @override
  State<QuizScreen> createState() => _QuizScreenState();
}

class _QuizScreenState extends State<QuizScreen> {
  late List<PreparedQuestion> matchQuestions;
  int currentIndex = 0;
  double qi = 100;
  int correctCount = 0;
  int wrongCount = 0;
  int currentStreak = 0;
  int maxStreakInMatch = 0;
  int timeLeft = 0;
  Timer? timer;
  int? selectedOption;
  bool answered = false;
  DateTime? questionStartTime;
  final Set<String> unlockedThisMatch = {};

  @override
  void initState() {
    super.initState();
    final rng = Random();
    final pool = widget.difficulty == Difficulty.impossivel
        ? List<Question>.from(kQuestionBank)
        : kQuestionBank.where((q) => q.difficulty == widget.difficulty).toList();
    pool.shuffle(rng);
    matchQuestions = pool.take(10).map((q) => _prepareQuestion(q, rng)).toList();
    _startQuestion();
  }

  @override
  void dispose() {
    timer?.cancel();
    super.dispose();
  }

  int get totalTime => kDifficultyTime[widget.difficulty]!;

  void _startQuestion() {
    answered = false;
    selectedOption = null;
    timeLeft = totalTime;
    questionStartTime = DateTime.now();
    timer?.cancel();
    timer = Timer.periodic(const Duration(seconds: 1), (t) {
      if (!mounted) return;
      setState(() {
        timeLeft--;
        if (timeLeft <= 0) {
          t.cancel();
          _handleAnswer(null);
        }
      });
    });
  }

  void _handleAnswer(int? index) {
    if (answered) return;
    timer?.cancel();

    final question = matchQuestions[currentIndex];
    final elapsedMs = DateTime.now().difference(questionStartTime!).inMilliseconds;
    final responseTime = elapsedMs / 1000.0;
    final correct = index != null && index == question.correctIndex;
    final points = kDifficultyPoints[widget.difficulty]!;

    setState(() {
      answered = true;
      selectedOption = index;

      if (correct) {
        correctCount++;
        currentStreak++;
        if (currentStreak > maxStreakInMatch) maxStreakInMatch = currentStreak;
        qi += points;
      } else {
        wrongCount++;
        currentStreak = 0;
        qi -= points * 0.10;
        if (qi < 0) qi = 0;
      }

      final newly = GameStats.instance.registerAnswer(
        correct: correct,
        difficulty: widget.difficulty,
        category: question.original.category,
        responseTimeSeconds: responseTime,
        currentStreak: currentStreak,
        currentQI: qi,
      );
      unlockedThisMatch.addAll(newly);
    });

    Future.delayed(const Duration(milliseconds: 1300), () {
      if (!mounted) return;
      if (currentIndex + 1 < matchQuestions.length) {
        setState(() => currentIndex++);
        _startQuestion();
      } else {
        _finishMatch();
      }
    });
  }

  void _finishMatch() {
    final newly = GameStats.instance.finishMatch(
      difficulty: widget.difficulty,
      wrongInMatch: wrongCount,
      finalQI: qi,
    );
    unlockedThisMatch.addAll(newly);

    Navigator.pushReplacement(
      context,
      MaterialPageRoute(
        builder: (_) => ResultScreen(
          difficulty: widget.difficulty,
          finalQI: qi,
          correctCount: correctCount,
          wrongCount: wrongCount,
          totalQuestions: matchQuestions.length,
          unlockedIds: unlockedThisMatch.toList(),
        ),
      ),
    );
  }

  Color _optionColor(int idx, PreparedQuestion q) {
    if (!answered) return Colors.white;
    if (idx == q.correctIndex) return const Color(0xFFBFE6C4);
    if (idx == selectedOption) return const Color(0xFFF3C0C0);
    return Colors.white;
  }

  @override
  Widget build(BuildContext context) {
    final question = matchQuestions[currentIndex];
    final color = kDifficultyColor[widget.difficulty]!;

    return Scaffold(
      appBar: AppBar(
        title: Text('${kDifficultyLabel[widget.difficulty]}  •  Pergunta ${currentIndex + 1}/${matchQuestions.length}'),
      ),
      body: Column(
        children: [
          // Barra de progresso do tempo
          ClipRRect(
            borderRadius: const BorderRadius.only(bottomLeft: Radius.circular(6), bottomRight: Radius.circular(6)),
            child: TweenAnimationBuilder<double>(
              tween: Tween(begin: 0, end: timeLeft / totalTime),
              duration: const Duration(milliseconds: 350),
              builder: (context, value, _) => LinearProgressIndicator(
                value: value.clamp(0, 1),
                minHeight: 7,
                backgroundColor: Colors.grey.shade300,
                valueColor: AlwaysStoppedAnimation(timeLeft <= 5 ? Colors.redAccent : color),
              ),
            ),
          ),
          Padding(
            padding: const EdgeInsets.fromLTRB(20, 12, 20, 0),
            child: Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: [
                Row(
                  children: [
                    const Icon(Icons.psychology, color: kStoneDark, size: 20),
                    const SizedBox(width: 6),
                    Text('QI: ${formatQI(qi)}', style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 16, color: kStoneDark)),
                  ],
                ),
                Row(
                  children: [
                    Icon(Icons.timer_outlined, color: timeLeft <= 5 ? Colors.redAccent : kTextMuted, size: 20),
                    const SizedBox(width: 6),
                    Text(
                      '${timeLeft}s',
                      style: TextStyle(
                        fontWeight: FontWeight.bold,
                        fontSize: 16,
                        color: timeLeft <= 5 ? Colors.redAccent : kTextMuted,
                      ),
                    ),
                  ],
                ),
              ],
            ),
          ),
          Expanded(
            child: SingleChildScrollView(
              padding: const EdgeInsets.all(20),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Container(
                    padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 5),
                    decoration: BoxDecoration(color: color.withOpacity(0.15), borderRadius: BorderRadius.circular(8)),
                    child: Text(
                      question.original.category,
                      style: TextStyle(color: color, fontWeight: FontWeight.bold, fontSize: 12),
                    ),
                  ),
                  const SizedBox(height: 14),
                  Text(
                    question.original.text,
                    style: const TextStyle(fontSize: 19, fontWeight: FontWeight.bold, color: kTextDark, height: 1.35),
                  ),
                  const SizedBox(height: 22),
                  for (int i = 0; i < question.options.length; i++)
                    Padding(
                      padding: const EdgeInsets.only(bottom: 12),
                      child: _OptionTile(
                        letter: String.fromCharCode(65 + i),
                        text: question.options[i],
                        color: _optionColor(i, question),
                        badgeColor: color,
                        onTap: () => _handleAnswer(i),
                        showIcon: answered && i == question.correctIndex,
                        showWrongIcon: answered && i == selectedOption && i != question.correctIndex,
                      ),
                    ),
                ],
              ),
            ),
          ),
        ],
      ),
    );
  }
}

class _OptionTile extends StatelessWidget {
  final String letter;
  final String text;
  final Color color;
  final Color badgeColor;
  final VoidCallback onTap;
  final bool showIcon;
  final bool showWrongIcon;

  const _OptionTile({
    required this.letter,
    required this.text,
    required this.color,
    required this.badgeColor,
    required this.onTap,
    required this.showIcon,
    required this.showWrongIcon,
  });

  @override
  Widget build(BuildContext context) {
    final resultBorder = showIcon
        ? const Color(0xFF3F9A56)
        : showWrongIcon
            ? const Color(0xFFD16A6A)
            : Colors.transparent;

    return AnimatedContainer(
      duration: const Duration(milliseconds: 250),
      curve: Curves.easeOut,
      decoration: BoxDecoration(
        borderRadius: BorderRadius.circular(14),
        border: Border.all(color: resultBorder, width: 2),
        boxShadow: [
          BoxShadow(color: Colors.black.withOpacity(0.06), blurRadius: 8, offset: const Offset(0, 3)),
        ],
      ),
      child: Material(
        color: color,
        borderRadius: BorderRadius.circular(14),
        child: InkWell(
          borderRadius: BorderRadius.circular(14),
          onTap: onTap,
          child: Padding(
            padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 12),
            child: Row(
              children: [
                CircleAvatar(
                  radius: 15,
                  backgroundColor: (showIcon || showWrongIcon) ? Colors.transparent : badgeColor.withOpacity(0.12),
                  child: Text(
                    letter,
                    style: TextStyle(
                      fontWeight: FontWeight.bold,
                      fontSize: 13,
                      color: (showIcon || showWrongIcon) ? kTextDark : badgeColor,
                    ),
                  ),
                ),
                const SizedBox(width: 12),
                Expanded(
                  child: Text(text, style: const TextStyle(fontSize: 15, color: kTextDark, height: 1.3)),
                ),
                if (showIcon) const Icon(Icons.check_circle, color: Color(0xFF3F9A56)),
                if (showWrongIcon) const Icon(Icons.cancel, color: Color(0xFFD16A6A)),
              ],
            ),
          ),
        ),
      ),
    );
  }
}

// ============================================================================
// TELA DE RESULTADO
// ============================================================================

class ResultScreen extends StatelessWidget {
  final Difficulty difficulty;
  final double finalQI;
  final int correctCount;
  final int wrongCount;
  final int totalQuestions;
  final List<String> unlockedIds;

  const ResultScreen({
    super.key,
    required this.difficulty,
    required this.finalQI,
    required this.correctCount,
    required this.wrongCount,
    required this.totalQuestions,
    required this.unlockedIds,
  });

  @override
  Widget build(BuildContext context) {
    final unlockedAchievements = kAchievements.where((a) => unlockedIds.contains(a.id)).toList();

    return Scaffold(
      backgroundColor: kStoneDark,
      body: SafeArea(
        child: Padding(
          padding: const EdgeInsets.all(24),
          child: Column(
            children: [
              const SizedBox(height: 12),
              const Icon(Icons.emoji_events_rounded, color: kGold, size: 56),
              const SizedBox(height: 12),
              const Text('Partida concluída!', style: TextStyle(color: Colors.white, fontSize: 22, fontWeight: FontWeight.bold)),
              const SizedBox(height: 20),
              Container(
                padding: const EdgeInsets.all(20),
                decoration: BoxDecoration(color: kStoneDarker, borderRadius: BorderRadius.circular(16)),
                child: Column(
                  children: [
                    const Text('QI FINAL', style: TextStyle(color: kGold, fontWeight: FontWeight.bold, letterSpacing: 1.5, fontSize: 12)),
                    const SizedBox(height: 6),
                    Text(formatQI(finalQI), style: const TextStyle(color: Colors.white, fontSize: 44, fontWeight: FontWeight.w900)),
                    const SizedBox(height: 14),
                    Row(
                      mainAxisAlignment: MainAxisAlignment.spaceEvenly,
                      children: [
                        _ResultStat(label: 'Acertos', value: '$correctCount/$totalQuestions'),
                        _ResultStat(label: 'Erros', value: '$wrongCount/$totalQuestions'),
                        _ResultStat(label: 'Dificuldade', value: kDifficultyLabel[difficulty]!),
                      ],
                    ),
                  ],
                ),
              ),
              const SizedBox(height: 20),
              if (unlockedAchievements.isNotEmpty) ...[
                const Align(
                  alignment: Alignment.centerLeft,
                  child: Text('Novas conquistas', style: TextStyle(color: Colors.white, fontWeight: FontWeight.bold, fontSize: 15)),
                ),
                const SizedBox(height: 10),
                Expanded(
                  child: ListView.builder(
                    itemCount: unlockedAchievements.length,
                    itemBuilder: (context, i) {
                      final a = unlockedAchievements[i];
                      return Container(
                        margin: const EdgeInsets.only(bottom: 10),
                        padding: const EdgeInsets.all(12),
                        decoration: BoxDecoration(color: kStoneDarker, borderRadius: BorderRadius.circular(12)),
                        child: Row(
                          children: [
                            const CircleAvatar(backgroundColor: kGold, radius: 18, child: Icon(Icons.star, color: kStoneDark, size: 18)),
                            const SizedBox(width: 12),
                            Expanded(
                              child: Column(
                                crossAxisAlignment: CrossAxisAlignment.start,
                                children: [
                                  Text(a.title, style: const TextStyle(color: Colors.white, fontWeight: FontWeight.bold)),
                                  Text(a.description, style: const TextStyle(color: Color(0xFFB9D0BC), fontSize: 12)),
                                ],
                              ),
                            ),
                          ],
                        ),
                      );
                    },
                  ),
                ),
              ] else
                const Spacer(),
              const SizedBox(height: 8),
              Row(
                children: [
                  Expanded(
                    child: OutlinedButton(
                      style: OutlinedButton.styleFrom(
                        side: const BorderSide(color: Colors.white54),
                        padding: const EdgeInsets.symmetric(vertical: 14),
                        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
                      ),
                      onPressed: () {
                        Navigator.pushAndRemoveUntil(
                          context,
                          MaterialPageRoute(builder: (_) => const HomeScreen()),
                          (route) => false,
                        );
                      },
                      child: const Text('Menu', style: TextStyle(color: Colors.white)),
                    ),
                  ),
                  const SizedBox(width: 12),
                  Expanded(
                    child: ElevatedButton(
                      style: ElevatedButton.styleFrom(
                        backgroundColor: kGold,
                        foregroundColor: kStoneDarker,
                        padding: const EdgeInsets.symmetric(vertical: 14),
                        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
                      ),
                      onPressed: () {
                        Navigator.pushReplacement(
                          context,
                          MaterialPageRoute(builder: (_) => QuizScreen(difficulty: difficulty)),
                        );
                      },
                      child: const Text('Jogar novamente', style: TextStyle(fontWeight: FontWeight.bold)),
                    ),
                  ),
                ],
              ),
            ],
          ),
        ),
      ),
    );
  }
}

class _ResultStat extends StatelessWidget {
  final String label;
  final String value;

  const _ResultStat({required this.label, required this.value});

  @override
  Widget build(BuildContext context) {
    return Column(
      children: [
        Text(value, style: const TextStyle(color: Colors.white, fontSize: 16, fontWeight: FontWeight.bold)),
        const SizedBox(height: 2),
        Text(label, style: const TextStyle(color: Color(0xFFB9D0BC), fontSize: 11)),
      ],
    );
  }
}

// ============================================================================
// TELA DE ESTATÍSTICAS
// ============================================================================

class StatisticsScreen extends StatelessWidget {
  const StatisticsScreen({super.key});

  @override
  Widget build(BuildContext context) {
    final stats = GameStats.instance;

    return Scaffold(
      appBar: AppBar(title: const Text('Estatísticas')),
      body: ListView(
        padding: const EdgeInsets.all(20),
        children: [
          _StatCard(icon: Icons.psychology, label: 'QI máximo alcançado', value: formatQI(stats.maxQI == 0 ? 100 : stats.maxQI)),
          _StatCard(icon: Icons.quiz, label: 'Perguntas respondidas', value: '${stats.totalQuestions}'),
          _StatCard(
            icon: Icons.check_circle_outline,
            label: 'Acertos / Erros',
            value: '${stats.totalCorrect} / ${stats.totalWrong}  (${stats.accuracy.toStringAsFixed(0)}% de aproveitamento)',
          ),
          _StatCard(icon: Icons.local_fire_department, label: 'Sequência máxima de acertos', value: '${stats.bestStreakEver}'),
          _StatCard(icon: Icons.timer, label: 'Tempo médio de resposta', value: '${stats.avgResponseTime.toStringAsFixed(1)}s'),
          _StatCard(icon: Icons.sports_esports, label: 'Partidas jogadas', value: '${stats.gamesPlayed}'),
          _StatCard(
            icon: Icons.emoji_events,
            label: 'Conquistas desbloqueadas',
            value: '${stats.unlockedAchievements.length} / ${kAchievements.length}',
          ),
          _StatCard(icon: Icons.trending_up, label: 'Categoria mais forte', value: stats.strongestCategory ?? '—'),
          _StatCard(icon: Icons.trending_down, label: 'Categoria a reforçar', value: stats.weakestCategory ?? '—'),
          const SizedBox(height: 8),
          const Text('Desempenho por dificuldade', style: TextStyle(fontWeight: FontWeight.bold, color: kTextDark, fontSize: 15)),
          const SizedBox(height: 10),
          for (final d in Difficulty.values)
            Padding(
              padding: const EdgeInsets.only(bottom: 10),
              child: Row(
                children: [
                  CircleAvatar(radius: 6, backgroundColor: kDifficultyColor[d]),
                  const SizedBox(width: 10),
                  Expanded(child: Text(kDifficultyLabel[d]!, style: const TextStyle(color: kTextDark))),
                  Text(
                    '${stats.correctByDifficulty[d] ?? 0} acertos / ${stats.wrongByDifficulty[d] ?? 0} erros',
                    style: const TextStyle(color: kTextMuted, fontSize: 12.5),
                  ),
                ],
              ),
            ),
        ],
      ),
    );
  }
}

class _StatCard extends StatelessWidget {
  final IconData icon;
  final String label;
  final String value;

  const _StatCard({required this.icon, required this.label, required this.value});

  @override
  Widget build(BuildContext context) {
    return Card(
      margin: const EdgeInsets.only(bottom: 12),
      elevation: 1,
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
      child: ListTile(
        leading: CircleAvatar(backgroundColor: kGold, child: Icon(icon, color: kStoneDark, size: 20)),
        title: Text(label, style: const TextStyle(fontSize: 13, color: kTextMuted)),
        subtitle: Text(value, style: const TextStyle(fontSize: 15, fontWeight: FontWeight.bold, color: kTextDark)),
      ),
    );
  }
}

// ============================================================================
// TELA DE CONQUISTAS
// ============================================================================

class AchievementsScreen extends StatelessWidget {
  const AchievementsScreen({super.key});

  @override
  Widget build(BuildContext context) {
    final unlocked = GameStats.instance.unlockedAchievements;

    return Scaffold(
      appBar: AppBar(title: const Text('Conquistas')),
      body: ListView.builder(
        padding: const EdgeInsets.all(20),
        itemCount: kAchievements.length,
        itemBuilder: (context, i) {
          final a = kAchievements[i];
          final isUnlocked = unlocked.contains(a.id);
          return Card(
            margin: const EdgeInsets.only(bottom: 12),
            elevation: isUnlocked ? 2 : 0,
            color: isUnlocked ? Colors.white : const Color(0xFFEFEFEF),
            shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
            child: ListTile(
              leading: CircleAvatar(
                backgroundColor: isUnlocked ? kGold : Colors.grey.shade400,
                child: Icon(isUnlocked ? Icons.star : Icons.lock_outline, color: Colors.white, size: 20),
              ),
              title: Text(
                a.title,
                style: TextStyle(
                  fontWeight: FontWeight.bold,
                  color: isUnlocked ? kTextDark : kTextMuted,
                ),
              ),
              subtitle: Text(a.description, style: const TextStyle(fontSize: 12.5, color: kTextMuted)),
            ),
          );
        },
      ),
    );
  }
}
